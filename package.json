{
  "name": "x3-crm",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:backend": "npm run dev --workspace=apps/backend",
    "dev:backend:x3sales": "npm run dev:backend:x3sales --workspace=apps/backend",
    "dev:frontend": "npm run dev --workspace=apps/frontend",
    "dev:reverb": ".\\tooling\\development\\dev-reverb.cmd",
    "dev:queue": ".\\tooling\\development\\dev-queue-worker.cmd",
    "dev:realtime": "concurrently \"npm run dev:reverb\" \"npm run dev:queue\"",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\" \"npm run dev:reverb\" \"npm run dev:queue\"",
    "dev:db": "docker compose -f tooling/development/compose.local.yml up -d postgres",
    "dev:docker": "docker compose -f tooling/development/compose.full.yml up -d --build",
    "db:tunnel": ".\\tooling\\development\\db-server-tunnel.cmd",
    "deploy:production": ".\\tooling\\deployment\\deploy-production.cmd",
    "build:backend": "npm run build --workspace=apps/backend",
    "build:frontend": "npm run build --workspace=apps/frontend",
    "db:migrate": "npm run db:migrate --workspace=apps/backend",
    "db:seed": "npm run db:seed --workspace=apps/backend",
    "db:fresh": "npm run db:fresh --workspace=apps/backend"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
